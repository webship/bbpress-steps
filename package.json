{
  "name": "@webship-js/bbpress-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for forums on WordPress with bbPress, a plugin for webship-js (Playwright and Cucumber): the forum index, a forum and its topics, a topic and its posts, the topic and reply forms (tags, formatting, an edit with its reason), subscriptions and favorites, the forum profile, the forum search, topic tags and views, moderation (close, stick, approve, spam, trash, merge, split, move), what each forum role may do, the forums' administration screens and settings, and the notification e-mails. It brings @webship-js/wordpress-steps along for the login and the administration area.",
  "main": "tests/step-definitions/bbpress-defaults.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "bbpress",
    "wordpress",
    "forum",
    "forums",
    "moderation",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "gherkin",
    "step-definitions",
    "e2e-testing"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/bbpress-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/bbpress-steps/issues"
  },
  "homepage": "https://github.com/webship/bbpress-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "dependencies": {
    "@webship-js/wordpress-steps": "^2.2.4"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
